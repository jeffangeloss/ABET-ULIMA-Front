# Exports, planillas y respaldos con datos personales: nunca entran al repositorio.
# Los datos inventados de las pruebas de aceptación van en tests/datos_inventados/, y
# scripts/preflight.sh comprueba que solo traigan códigos de estudiante que empiezan con 99.
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.ods
*.dump
*.dump.gpg
!tests/datos_inventados/
!tests/datos_inventados/**

# Secretos y configuración local
.env
.env.*
!.env.example
*.pem
*.key

# Node, Vite y pruebas
node_modules/
dist/
coverage/
playwright-report/
test-results/
.vite/

# Sistema y registros
.DS_Store
*.log
